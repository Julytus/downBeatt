# =====================================================================
# LOCAL DEV — mẫu. Tạo file thật:  cp backend/.env.example backend/.env
# Dùng cho:
#   1. Backend chạy trên máy: Spring tự đọc backend/.env (spring.config.import)
#   2. Hạ tầng dev:  docker compose -f docker-compose.local.yml --env-file backend/.env up -d
# Server/deploy dùng .env ở thư mục gốc (xem /.env.example).
# Lưu ý: KHÔNG bọc giá trị trong dấu "..." — Spring đọc file dạng .properties
#        nên dấu nháy sẽ bị tính luôn vào giá trị.
# =====================================================================

# -----------------------------
# 🌱 Ứng dụng (DownBeat — cổng hạ tầng lệch +10 so với dự án cũ để chạy song song)
# -----------------------------
# Spring profile: local = chạy trên máy (application-local.yml)
SPRING_PROFILES_ACTIVE=local
# Cổng HTTP của backend local → API tại http://localhost:9200/api
BACKEND_PORT=9200

# -----------------------------
# 🧱 MySQL
# -----------------------------
# Mật khẩu user root (container mysql local tạo theo giá trị này ở lần chạy đầu)
MYSQL_ROOT_PASSWORD=root
# Tên database (giống server). Lần đầu nạp dump deploy/mysql/server-init, rồi Flyway chạy migration + seed
MYSQL_DATABASE=downBeat
# Cổng MySQL trên máy (127.0.0.1) — backend local kết nối qua cổng này
MYSQL_PORT=3326

# -----------------------------
# 🧱 Redis (cache)
# -----------------------------
# Host Redis mà backend local kết nối
REDIS_HOST=localhost
# Cổng Redis trên máy (127.0.0.1)
REDIS_PORT=6399
# Mật khẩu Redis; để trống = không đặt mật khẩu (chỉ nên dùng ở local)
REDIS_PASSWORD=

# -----------------------------
# 🧱 MinIO (lưu file/ảnh upload)
# -----------------------------
# Tài khoản quản trị MinIO (cũng là access key backend dùng để upload)
MINIO_ROOT_USER=minioadmin
# Mật khẩu MinIO (cũng là secret key backend dùng để upload), tối thiểu 8 ký tự
MINIO_ROOT_PASSWORD=minioadmin
# Cổng S3 API của MinIO trên máy; link file local = http://localhost:9020/<bucket>/...
MINIO_PORT=9020
# Cổng giao diện quản trị MinIO: http://localhost:9021
MINIO_CONSOLE_PORT=9021

# -----------------------------
# 🧰 Công cụ
# -----------------------------
# Cổng phpMyAdmin (chỉ chạy khi thêm --profile tools): http://localhost:8092
PHPMYADMIN_PORT=8092
# Cổng SMTP Mailpit (SMTP giả khi dev) — backend local gửi mail qua cổng này
MAILPIT_SMTP_PORT=1026
# Giao diện Mailpit xem mail đã gửi: http://localhost:8026
MAILPIT_UI_PORT=8026

# -----------------------------
# 🔐 JWT / API Key
# -----------------------------
# Khóa ký JWT; đổi giá trị => toàn bộ token đang đăng nhập bị vô hiệu. Phải KHÁC với server.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
# Khóa cho hệ thống bên ngoài gọi API qua header x-api-key (quyền operator)
API_KEY=change-me-to-a-random-api-key

# -----------------------------
# 📧 Mail (SMTP) — gửi OTP quên mật khẩu
# -----------------------------
# Máy chủ SMTP
MAIL_HOST=smtp.gmail.com
# Cổng SMTP (587 = STARTTLS)
MAIL_PORT=587
# Tài khoản gửi mail
MAIL_USERNAME=
# Mật khẩu ứng dụng (Gmail App Password), không dùng mật khẩu đăng nhập Gmail
MAIL_PASSWORD=
