# =====================================================================
# SERVER / DEPLOY — mẫu cho docker-compose.yml (thư mục gốc).
#   cp .env.example .env  rồi đổi toàn bộ giá trị "change-me".
# Dev local KHÔNG dùng file này: xem backend/.env.example và frontend/.env.example
# Đổi giá trị xong:  docker compose up -d   (compose tự tạo lại container bị ảnh hưởng)
# =====================================================================

# -----------------------------
# 🌐 Truy cập
# -----------------------------
# Cổng nginx mở ra host — cổng duy nhất của stack server (khác 9100/4200 của dev local)
HTTP_PORT=80
# URL người dùng truy cập (domain Cloudflare Tunnel, hoặc http://<IP>:<HTTP_PORT>);
# dùng để tạo link file upload: ${PUBLIC_URL}/s3/<bucket>/...
PUBLIC_URL=http://localhost

# -----------------------------
# 🧱 MySQL (chỉ trong mạng docker, không mở cổng ra host)
# -----------------------------
# Mật khẩu root; chỉ có tác dụng ở LẦN ĐẦU tạo volume — đổi sau đó phải đổi cả trong MySQL
MYSQL_ROOT_PASSWORD=change-me
# Tên database. Lần đầu (volume trống): nạp dump trong deploy/mysql/server-init, rồi backend chạy Flyway
MYSQL_DATABASE=downBeat

# -----------------------------
# 🧱 MinIO (lưu file/ảnh upload)
# -----------------------------
# Tài khoản quản trị MinIO (cũng là access key backend dùng để upload)
MINIO_ROOT_USER=downbeat-admin
# Mật khẩu MinIO (cũng là secret key backend), tối thiểu 8 ký tự
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# Bucket chứa file; tự tạo (public-read) khi backend khởi động nếu chưa có
MINIO_BUCKET=downbeat

# -----------------------------
# 📨 Kafka (bộ đệm command giữa API và DB, chỉ trong mạng docker)
# -----------------------------
# Số consumer song song ghi DB (<= số partition topic command, mặc định 3)
KAFKA_CONSUMER_CONCURRENCY=3
# Số message tối đa mỗi lần poll của 1 consumer
KAFKA_MAX_POLL_RECORDS=50
# Nghỉ (ms) giữa 2 lần poll để giảm tốc ghi DB khi DB yếu; 0 = không nghỉ
KAFKA_IDLE_BETWEEN_POLLS=0
# RAM JVM của Kafka broker
KAFKA_HEAP_OPTS=-Xmx512m -Xms256m

# -----------------------------
# 📤 Upload
# -----------------------------
# Dung lượng tối đa 1 file (vd: 10MB). Không vượt 20MB vì nginx giới hạn client_max_body_size 20m
UPLOAD_MAX_SIZE=10MB

# -----------------------------
# 🔐 Bảo mật — phải KHÁC giá trị dev để token dev không dùng được trên server
# -----------------------------
# Khóa ký JWT (>= 32 ký tự ngẫu nhiên); đổi => mọi người dùng phải đăng nhập lại
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
# Khóa cho hệ thống bên ngoài gọi API qua header x-api-key (quyền operator)
API_KEY=change-me-to-a-random-api-key

# -----------------------------
# 🧰 Tuỳ chọn
# -----------------------------
# Cổng phpMyAdmin của DB server (luôn chạy cùng stack), chỉ bind 127.0.0.1: http://localhost:8082
# Đăng nhập: root / MYSQL_ROOT_PASSWORD
DEPLOY_PHPMYADMIN_PORT=8082
# Cổng Kafka UI của server (chỉ khi --profile tools), bind 127.0.0.1: http://localhost:8086
DEPLOY_KAFKA_UI_PORT=8086
# Token Cloudflare Tunnel (chỉ khi --profile tunnel); tunnel trỏ tới http://nginx:80
CLOUDFLARE_TOKEN=
# Tham số JVM của backend: RAM tối đa theo % giới hạn container, tắt hẳn khi hết RAM, múi giờ VN
BACKEND_JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Ho_Chi_Minh
