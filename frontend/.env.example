# =====================================================================
# LOCAL DEV (pnpm dev, cổng 4500) — mẫu. Tạo file thật: cp .env.example .env
# Bản docker KHÔNG dùng file này: được build với VITE_API_URL=/api (đi qua nginx).
# Chỉ biến có tiền tố VITE_ mới vào được code frontend — đừng đặt secret ở đây.
# =====================================================================

# URL API backend. Local: backend chạy :9500 với context-path /api
VITE_API_URL=http://localhost:9500/api
